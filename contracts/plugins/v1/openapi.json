{
  "components": {
    "parameters": {
      "Deadline": {
        "in": "header",
        "name": "X-Deadline-Unix-Ms",
        "required": true,
        "schema": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "RequestId": {
        "in": "header",
        "name": "X-Request-Id",
        "required": true,
        "schema": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "TraceContext": {
        "in": "header",
        "name": "traceparent",
        "required": false,
        "schema": {
          "maxLength": 128,
          "type": "string"
        }
      }
    },
    "responses": {
      "ConnectorError": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ConnectorError"
            }
          }
        },
        "description": "Structured connector error without upstream bodies or secrets"
      }
    },
    "schemas": {
      "CapabilityDeclaration": {
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "sideEffect": {
                  "const": "external_write"
                }
              },
              "required": [
                "sideEffect"
              ]
            },
            "then": {
              "properties": {
                "access": {
                  "const": "write"
                }
              },
              "required": [
                "writeSemantics"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "sideEffect": {
                  "enum": [
                    "none",
                    "external_read"
                  ]
                }
              },
              "required": [
                "sideEffect"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "writeSemantics"
                ]
              }
            }
          }
        ],
        "dependentRequired": {
          "inputSchema": [
            "outputSchema"
          ],
          "outputSchema": [
            "inputSchema"
          ]
        },
        "properties": {
          "access": {
            "enum": [
              "read",
              "write"
            ]
          },
          "id": {
            "maxLength": 128,
            "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]*[a-z0-9])?)*$",
            "type": "string"
          },
          "inputSchema": {
            "type": "object"
          },
          "outputSchema": {
            "type": "object"
          },
          "sideEffect": {
            "enum": [
              "none",
              "external_read",
              "external_write"
            ]
          },
          "version": {
            "maximum": 65535,
            "minimum": 1,
            "type": "integer"
          },
          "writeSemantics": {
            "$ref": "#/components/schemas/ExternalWriteSemantics"
          }
        },
        "required": [
          "id",
          "version",
          "access",
          "sideEffect"
        ],
        "type": "object"
      },
      "CapabilityInvocation": {
        "additionalProperties": false,
        "properties": {
          "capabilityVersion": {
            "maximum": 65535,
            "minimum": 1,
            "type": "integer"
          },
          "input": {}
        },
        "required": [
          "capabilityVersion",
          "input"
        ],
        "type": "object"
      },
      "CapabilityResult": {
        "additionalProperties": false,
        "properties": {
          "output": {}
        },
        "required": [
          "output"
        ],
        "type": "object"
      },
      "ConnectorError": {
        "additionalProperties": true,
        "properties": {
          "code": {
            "enum": [
              "invalid_configuration",
              "unsupported",
              "authentication_required",
              "forbidden",
              "rate_limited",
              "temporarily_unavailable",
              "conflict",
              "upstream_failure",
              "partial_success",
              "outcome_unknown",
              "invalid_response"
            ]
          },
          "outcome": {
            "enum": [
              "not_applied",
              "applied",
              "unknown"
            ]
          },
          "retryAfterMs": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "code",
          "outcome"
        ],
        "type": "object"
      },
      "ConnectorHealth": {
        "additionalProperties": true,
        "properties": {
          "checkedAtUnixMs": {
            "minimum": 1,
            "type": "integer"
          },
          "errorCode": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "healthy",
              "degraded",
              "unavailable"
            ]
          }
        },
        "required": [
          "status",
          "checkedAtUnixMs"
        ],
        "type": "object"
      },
      "ConnectorLimits": {
        "additionalProperties": true,
        "properties": {
          "maxConcurrency": {
            "maximum": 1024,
            "minimum": 1,
            "type": "integer"
          },
          "maxPageSize": {
            "maximum": 10000,
            "minimum": 1,
            "type": "integer"
          },
          "maxResponseBytes": {
            "maximum": 16777216,
            "minimum": 1,
            "type": "integer"
          },
          "requestTimeoutMs": {
            "maximum": 300000,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "maxConcurrency",
          "requestTimeoutMs",
          "maxResponseBytes",
          "maxPageSize"
        ],
        "type": "object"
      },
      "ContractVersion": {
        "additionalProperties": true,
        "properties": {
          "major": {
            "maximum": 65535,
            "minimum": 1,
            "type": "integer"
          },
          "minor": {
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "major",
          "minor"
        ],
        "type": "object"
      },
      "ContractVersionRange": {
        "additionalProperties": true,
        "properties": {
          "maximum": {
            "$ref": "#/components/schemas/ContractVersion"
          },
          "minimum": {
            "$ref": "#/components/schemas/ContractVersion"
          }
        },
        "required": [
          "minimum",
          "maximum"
        ],
        "type": "object"
      },
      "ExternalAccountProfile": {
        "additionalProperties": true,
        "properties": {
          "displayName": {
            "maxLength": 256,
            "type": "string"
          },
          "subject": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "subject"
        ],
        "type": "object"
      },
      "ExternalBalanceSnapshot": {
        "additionalProperties": true,
        "properties": {
          "amount": {
            "maxLength": 128,
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "type": "string"
          },
          "observedAtUnixMs": {
            "minimum": 1,
            "type": "integer"
          },
          "unit": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "amount",
          "unit",
          "observedAtUnixMs"
        ],
        "type": "object"
      },
      "ExternalWriteSemantics": {
        "additionalProperties": true,
        "properties": {
          "nativeIdempotencyKey": {
            "type": "boolean"
          },
          "reconciliation": {
            "type": "boolean"
          },
          "resultLookup": {
            "enum": [
              "none",
              "by_request_id",
              "by_external_reference"
            ]
          }
        },
        "required": [
          "nativeIdempotencyKey",
          "resultLookup",
          "reconciliation"
        ],
        "type": "object"
      },
      "InvocationMetadata": {
        "additionalProperties": true,
        "properties": {
          "deadlineUnixMs": {
            "minimum": 1,
            "type": "integer"
          },
          "requestId": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "requestId",
          "deadlineUnixMs"
        ],
        "type": "object"
      },
      "PluginHostOperation": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "manifest"
              }
            },
            "required": [
              "operation"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "operation": {
                "const": "health"
              }
            },
            "required": [
              "operation"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "capabilityId": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]*[a-z0-9])?)*$",
                "type": "string"
              },
              "capabilityVersion": {
                "maximum": 65535,
                "minimum": 1,
                "type": "integer"
              },
              "connectionId": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              "input": {},
              "operation": {
                "const": "invoke_capability"
              },
              "publicConfig": {
                "type": "object"
              }
            },
            "required": [
              "operation",
              "connectionId",
              "publicConfig",
              "capabilityId",
              "capabilityVersion",
              "input"
            ],
            "type": "object"
          }
        ]
      },
      "PluginHostProtocol": {
        "additionalProperties": false,
        "properties": {
          "encoding": {
            "const": "utf-8-json"
          },
          "framing": {
            "const": "one-json-object-per-line"
          },
          "maxFrameBytes": {
            "maximum": 16777216,
            "minimum": 1,
            "type": "integer"
          },
          "operations": {
            "const": [
              "manifest",
              "health",
              "invoke_capability"
            ]
          }
        },
        "required": [
          "encoding",
          "framing",
          "maxFrameBytes",
          "operations"
        ],
        "type": "object"
      },
      "PluginHostRequest": {
        "additionalProperties": false,
        "properties": {
          "artifactSha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "deadlineUnixMs": {
            "minimum": 1,
            "type": "integer"
          },
          "deploymentGeneration": {
            "minimum": 1,
            "type": "integer"
          },
          "operation": {
            "$ref": "#/components/schemas/PluginHostOperation"
          },
          "pluginId": {
            "maxLength": 128,
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$",
            "type": "string"
          },
          "pluginVersion": {
            "maxLength": 128,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
            "type": "string"
          },
          "protocolVersion": {
            "const": 1
          },
          "requestId": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "protocolVersion",
          "pluginId",
          "pluginVersion",
          "artifactSha256",
          "deploymentGeneration",
          "requestId",
          "deadlineUnixMs",
          "operation"
        ],
        "type": "object"
      },
      "PluginHostResponse": {
        "additionalProperties": false,
        "properties": {
          "artifactSha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "deploymentGeneration": {
            "minimum": 1,
            "type": "integer"
          },
          "pluginId": {
            "maxLength": 128,
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$",
            "type": "string"
          },
          "pluginVersion": {
            "maxLength": 128,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
            "type": "string"
          },
          "protocolVersion": {
            "const": 1
          },
          "requestId": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/PluginHostResult"
          }
        },
        "required": [
          "protocolVersion",
          "pluginId",
          "pluginVersion",
          "artifactSha256",
          "deploymentGeneration",
          "requestId",
          "result"
        ],
        "type": "object"
      },
      "PluginHostResult": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "manifest"
              },
              "value": {
                "$ref": "#/components/schemas/PluginManifest"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "health"
              },
              "value": {
                "$ref": "#/components/schemas/ConnectorHealth"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "capability"
              },
              "value": {
                "$ref": "#/components/schemas/CapabilityResult"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "error"
              },
              "value": {
                "$ref": "#/components/schemas/ConnectorError"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "type": "object"
          }
        ]
      },
      "PluginManifest": {
        "additionalProperties": true,
        "properties": {
          "authenticationModes": {
            "items": {
              "maxLength": 128,
              "pattern": "^[a-z0-9_-]+(?:\\.[a-z0-9_-]+)*$",
              "type": "string"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "capabilities": {
            "items": {
              "$ref": "#/components/schemas/CapabilityDeclaration"
            },
            "maxItems": 128,
            "minItems": 1,
            "type": "array"
          },
          "configSchema": {
            "type": "object"
          },
          "contractRange": {
            "$ref": "#/components/schemas/ContractVersionRange"
          },
          "displayName": {
            "maxLength": 128,
            "type": "string"
          },
          "limits": {
            "$ref": "#/components/schemas/ConnectorLimits"
          },
          "pluginId": {
            "maxLength": 128,
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$",
            "type": "string"
          },
          "pluginVersion": {
            "maxLength": 128,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
            "type": "string"
          }
        },
        "required": [
          "pluginId",
          "pluginVersion",
          "contractRange",
          "capabilities",
          "authenticationModes",
          "limits",
          "configSchema"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "HostCapabilityToken": {
        "bearerFormat": "short-lived scoped token",
        "description": "Issued by the host for one connector instance and granted capability set. Not a platform credential.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Language-neutral connector contract. Sidecars use bounded UTF-8 JSON Lines over host-managed stdin/stdout; platform secrets, wallet authority, and database access are not part of this contract.",
    "title": "AnyFlows Platform Connector Contract",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/accounts/{subject}": {
      "get": {
        "operationId": "readExternalAccountProfile",
        "parameters": [
          {
            "in": "path",
            "name": "subject",
            "required": true,
            "schema": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/Deadline"
          },
          {
            "$ref": "#/components/parameters/TraceContext"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalAccountProfile"
                }
              }
            },
            "description": "External account profile"
          },
          "default": {
            "$ref": "#/components/responses/ConnectorError"
          }
        },
        "summary": "Read the profile for a previously linked external subject"
      }
    },
    "/v1/accounts/{subject}/balance": {
      "get": {
        "operationId": "readExternalBalanceSnapshot",
        "parameters": [
          {
            "in": "path",
            "name": "subject",
            "required": true,
            "schema": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/Deadline"
          },
          {
            "$ref": "#/components/parameters/TraceContext"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExternalBalanceSnapshot"
                }
              }
            },
            "description": "External balance snapshot; not a host wallet balance"
          },
          "default": {
            "$ref": "#/components/responses/ConnectorError"
          }
        },
        "summary": "Read an external balance snapshot in its native unit"
      }
    },
    "/v1/capabilities/{capabilityId}": {
      "post": {
        "operationId": "invokeReadCapability",
        "parameters": [
          {
            "in": "path",
            "name": "capabilityId",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]*[a-z0-9])?)*$",
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/Deadline"
          },
          {
            "$ref": "#/components/parameters/TraceContext"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CapabilityInvocation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityResult"
                }
              }
            },
            "description": "Validated capability result"
          },
          "default": {
            "$ref": "#/components/responses/ConnectorError"
          }
        },
        "summary": "Invoke one negotiated read capability using its declared input and output schemas"
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "getConnectorHealth",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/Deadline"
          },
          {
            "$ref": "#/components/parameters/TraceContext"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectorHealth"
                }
              }
            },
            "description": "Connector health"
          }
        },
        "summary": "Return connector health without performing side effects"
      }
    },
    "/v1/manifest": {
      "get": {
        "operationId": "getPluginManifest",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/Deadline"
          },
          {
            "$ref": "#/components/parameters/TraceContext"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PluginManifest"
                }
              }
            },
            "description": "Plugin manifest"
          }
        },
        "summary": "Return plugin identity and declared capabilities"
      }
    }
  },
  "security": [
    {
      "HostCapabilityToken": []
    }
  ]
}
