{
  "$defs": {
    "CapabilityDeclaration": {
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "sideEffect": {
                "const": "external_write"
              }
            },
            "required": [
              "sideEffect"
            ]
          },
          "then": {
            "properties": {
              "access": {
                "const": "write"
              }
            },
            "required": [
              "writeSemantics"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "sideEffect": {
                "enum": [
                  "none",
                  "external_read"
                ]
              }
            },
            "required": [
              "sideEffect"
            ]
          },
          "then": {
            "not": {
              "required": [
                "writeSemantics"
              ]
            }
          }
        }
      ],
      "dependentRequired": {
        "inputSchema": [
          "outputSchema"
        ],
        "outputSchema": [
          "inputSchema"
        ]
      },
      "properties": {
        "access": {
          "enum": [
            "read",
            "write"
          ]
        },
        "id": {
          "maxLength": 128,
          "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]*[a-z0-9])?)*$",
          "type": "string"
        },
        "inputSchema": {
          "type": "object"
        },
        "outputSchema": {
          "type": "object"
        },
        "sideEffect": {
          "enum": [
            "none",
            "external_read",
            "external_write"
          ]
        },
        "version": {
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "writeSemantics": {
          "$ref": "#/$defs/ExternalWriteSemantics"
        }
      },
      "required": [
        "id",
        "version",
        "access",
        "sideEffect"
      ],
      "type": "object"
    },
    "CapabilityInvocation": {
      "additionalProperties": false,
      "properties": {
        "capabilityVersion": {
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "input": {}
      },
      "required": [
        "capabilityVersion",
        "input"
      ],
      "type": "object"
    },
    "CapabilityResult": {
      "additionalProperties": false,
      "properties": {
        "output": {}
      },
      "required": [
        "output"
      ],
      "type": "object"
    },
    "ConnectorError": {
      "additionalProperties": true,
      "properties": {
        "code": {
          "enum": [
            "invalid_configuration",
            "unsupported",
            "authentication_required",
            "forbidden",
            "rate_limited",
            "temporarily_unavailable",
            "conflict",
            "upstream_failure",
            "partial_success",
            "outcome_unknown",
            "invalid_response"
          ]
        },
        "outcome": {
          "enum": [
            "not_applied",
            "applied",
            "unknown"
          ]
        },
        "retryAfterMs": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "code",
        "outcome"
      ],
      "type": "object"
    },
    "ConnectorHealth": {
      "additionalProperties": true,
      "properties": {
        "checkedAtUnixMs": {
          "minimum": 1,
          "type": "integer"
        },
        "errorCode": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "healthy",
            "degraded",
            "unavailable"
          ]
        }
      },
      "required": [
        "status",
        "checkedAtUnixMs"
      ],
      "type": "object"
    },
    "ConnectorLimits": {
      "additionalProperties": true,
      "properties": {
        "maxConcurrency": {
          "maximum": 1024,
          "minimum": 1,
          "type": "integer"
        },
        "maxPageSize": {
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
        },
        "maxResponseBytes": {
          "maximum": 16777216,
          "minimum": 1,
          "type": "integer"
        },
        "requestTimeoutMs": {
          "maximum": 300000,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "maxConcurrency",
        "requestTimeoutMs",
        "maxResponseBytes",
        "maxPageSize"
      ],
      "type": "object"
    },
    "ContractVersion": {
      "additionalProperties": true,
      "properties": {
        "major": {
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "minor": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    },
    "ContractVersionRange": {
      "additionalProperties": true,
      "properties": {
        "maximum": {
          "$ref": "#/$defs/ContractVersion"
        },
        "minimum": {
          "$ref": "#/$defs/ContractVersion"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "type": "object"
    },
    "ExternalAccountProfile": {
      "additionalProperties": true,
      "properties": {
        "displayName": {
          "maxLength": 256,
          "type": "string"
        },
        "subject": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "subject"
      ],
      "type": "object"
    },
    "ExternalBalanceSnapshot": {
      "additionalProperties": true,
      "properties": {
        "amount": {
          "maxLength": 128,
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        },
        "observedAtUnixMs": {
          "minimum": 1,
          "type": "integer"
        },
        "unit": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "amount",
        "unit",
        "observedAtUnixMs"
      ],
      "type": "object"
    },
    "ExternalWriteSemantics": {
      "additionalProperties": true,
      "properties": {
        "nativeIdempotencyKey": {
          "type": "boolean"
        },
        "reconciliation": {
          "type": "boolean"
        },
        "resultLookup": {
          "enum": [
            "none",
            "by_request_id",
            "by_external_reference"
          ]
        }
      },
      "required": [
        "nativeIdempotencyKey",
        "resultLookup",
        "reconciliation"
      ],
      "type": "object"
    },
    "HostHttpMethod": {
      "enum": [
        "GET",
        "HEAD"
      ],
      "type": "string"
    },
    "HostHttpRequestProposal": {
      "additionalProperties": false,
      "properties": {
        "endpointId": {
          "maxLength": 128,
          "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]*[a-z0-9])?)*$",
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/HostHttpMethod"
        },
        "query": {
          "additionalProperties": {
            "maxLength": 512,
            "type": "string"
          },
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          },
          "type": "object"
        }
      },
      "required": [
        "endpointId",
        "method"
      ],
      "type": "object"
    },
    "HostHttpResponseProjection": {
      "additionalProperties": false,
      "properties": {
        "payload": {},
        "statusCode": {
          "maximum": 299,
          "minimum": 200,
          "type": "integer"
        }
      },
      "required": [
        "statusCode",
        "payload"
      ],
      "type": "object"
    },
    "JsonPatchOperation": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "enum": [
            "add",
            "remove",
            "replace"
          ]
        },
        "path": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "type": "array"
        },
        "value": {}
      },
      "required": [
        "op",
        "path"
      ],
      "type": "object"
    },
    "PluginEventDefinition": {
      "additionalProperties": false,
      "properties": {
        "capabilityId": {
          "maxLength": 128,
          "type": "string"
        },
        "capabilityVersion": {
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "eventKind": {
          "enum": [
            "channel.health.changed",
            "merchant.service.changed"
          ]
        },
        "filterFields": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "payloadSchema": {
          "type": "object"
        }
      },
      "required": [
        "eventKind",
        "capabilityId",
        "capabilityVersion",
        "payloadSchema",
        "filterFields"
      ],
      "type": "object"
    },
    "PluginEventSubscription": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "eventKind": {
                "const": "channel.health.changed"
              }
            },
            "required": [
              "eventKind"
            ]
          },
          "then": {
            "properties": {
              "capabilityId": {
                "const": "events.channel-health.changed.consume"
              },
              "capabilityVersion": {
                "const": 1
              },
              "filters": {
                "properties": {
                  "status": {
                    "items": {
                      "enum": [
                        "down",
                        "recovered"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventKind": {
                "const": "merchant.service.changed"
              }
            },
            "required": [
              "eventKind"
            ]
          },
          "then": {
            "properties": {
              "capabilityId": {
                "const": "events.merchant-service.changed.consume"
              },
              "capabilityVersion": {
                "const": 1
              },
              "filters": {
                "properties": {
                  "status": {
                    "items": {
                      "enum": [
                        "active",
                        "paused"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "capabilityId": {
          "maxLength": 128,
          "type": "string"
        },
        "capabilityVersion": {
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "eventKind": {
          "enum": [
            "channel.health.changed",
            "merchant.service.changed"
          ]
        },
        "filters": {
          "additionalProperties": false,
          "properties": {
            "status": {
              "items": {
                "enum": [
                  "down",
                  "recovered",
                  "active",
                  "paused"
                ]
              },
              "maxItems": 2,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "type": "object"
        }
      },
      "required": [
        "eventKind",
        "capabilityId",
        "capabilityVersion"
      ],
      "type": "object"
    },
    "PluginHostOperation": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "manifest"
            }
          },
          "required": [
            "operation"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "health"
            }
          },
          "required": [
            "operation"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "capabilityId": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]*[a-z0-9])?)*$",
              "type": "string"
            },
            "capabilityVersion": {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            "connectionId": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "input": {},
            "operation": {
              "const": "invoke_capability"
            },
            "publicConfig": {
              "type": "object"
            }
          },
          "required": [
            "operation",
            "connectionId",
            "publicConfig",
            "capabilityId",
            "capabilityVersion",
            "input"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "capabilityId": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]*[a-z0-9])?)*$",
              "type": "string"
            },
            "capabilityVersion": {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            "connectionId": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "operation": {
              "const": "invoke_task"
            },
            "publicConfig": {
              "type": "object"
            },
            "task": {
              "$ref": "#/$defs/PluginTaskOperation"
            }
          },
          "required": [
            "operation",
            "connectionId",
            "publicConfig",
            "capabilityId",
            "capabilityVersion",
            "task"
          ],
          "type": "object"
        }
      ]
    },
    "PluginHostProtocol": {
      "additionalProperties": false,
      "properties": {
        "encoding": {
          "const": "utf-8-json"
        },
        "framing": {
          "const": "one-json-object-per-line"
        },
        "maxFrameBytes": {
          "maximum": 16777216,
          "minimum": 1,
          "type": "integer"
        },
        "operations": {
          "const": [
            "manifest",
            "health",
            "invoke_capability",
            "invoke_task"
          ]
        }
      },
      "required": [
        "encoding",
        "framing",
        "maxFrameBytes",
        "operations"
      ],
      "type": "object"
    },
    "PluginHostRequest": {
      "additionalProperties": false,
      "properties": {
        "artifactSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "deadlineUnixMs": {
          "minimum": 1,
          "type": "integer"
        },
        "deploymentGeneration": {
          "minimum": 1,
          "type": "integer"
        },
        "operation": {
          "$ref": "#/$defs/PluginHostOperation"
        },
        "pluginId": {
          "maxLength": 128,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$",
          "type": "string"
        },
        "pluginVersion": {
          "maxLength": 128,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
          "type": "string"
        },
        "protocolVersion": {
          "const": 1
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "pluginId",
        "pluginVersion",
        "artifactSha256",
        "deploymentGeneration",
        "requestId",
        "deadlineUnixMs",
        "operation"
      ],
      "type": "object"
    },
    "PluginHostResponse": {
      "additionalProperties": false,
      "properties": {
        "artifactSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "deploymentGeneration": {
          "minimum": 1,
          "type": "integer"
        },
        "pluginId": {
          "maxLength": 128,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$",
          "type": "string"
        },
        "pluginVersion": {
          "maxLength": 128,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
          "type": "string"
        },
        "protocolVersion": {
          "const": 1
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/PluginHostResult"
        }
      },
      "required": [
        "protocolVersion",
        "pluginId",
        "pluginVersion",
        "artifactSha256",
        "deploymentGeneration",
        "requestId",
        "result"
      ],
      "type": "object"
    },
    "PluginHostResult": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "manifest"
            },
            "value": {
              "$ref": "#/$defs/PluginManifest"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "health"
            },
            "value": {
              "$ref": "#/$defs/ConnectorHealth"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "capability"
            },
            "value": {
              "$ref": "#/$defs/CapabilityResult"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "task"
            },
            "value": {
              "$ref": "#/$defs/PluginTaskResult"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "error"
            },
            "value": {
              "$ref": "#/$defs/ConnectorError"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "PluginManifest": {
      "additionalProperties": true,
      "properties": {
        "authenticationModes": {
          "items": {
            "maxLength": 128,
            "pattern": "^[a-z0-9_-]+(?:\\.[a-z0-9_-]+)*$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/CapabilityDeclaration"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array"
        },
        "configSchema": {
          "type": "object"
        },
        "contractRange": {
          "$ref": "#/$defs/ContractVersionRange"
        },
        "displayName": {
          "maxLength": 128,
          "type": "string"
        },
        "eventSubscriptions": {
          "items": {
            "$ref": "#/$defs/PluginEventSubscription"
          },
          "maxItems": 32,
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/ConnectorLimits"
        },
        "pluginId": {
          "maxLength": 128,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$",
          "type": "string"
        },
        "pluginVersion": {
          "$ref": "#/$defs/PluginVersion"
        },
        "uiContributions": {
          "items": {
            "$ref": "#/$defs/PluginUiContribution"
          },
          "maxItems": 16,
          "type": "array"
        },
        "uiPages": {
          "items": {
            "$ref": "#/$defs/PluginUiPage"
          },
          "maxItems": 32,
          "type": "array"
        },
        "uiViews": {
          "items": {
            "$ref": "#/$defs/PluginUiView"
          },
          "maxItems": 8,
          "type": "array"
        }
      },
      "required": [
        "pluginId",
        "pluginVersion",
        "contractRange",
        "capabilities",
        "authenticationModes",
        "limits",
        "configSchema"
      ],
      "type": "object"
    },
    "PluginProxyError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "authentication_required",
            "forbidden",
            "rate_limited",
            "temporarily_unavailable",
            "unsupported",
            "invalid_response"
          ]
        }
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "PluginProxyRequest": {
      "additionalProperties": false,
      "properties": {
        "artifactSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "capabilityId": {
          "maxLength": 128,
          "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]*[a-z0-9])?)*$",
          "type": "string"
        },
        "capabilityVersion": {
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "deploymentGeneration": {
          "minimum": 1,
          "type": "integer"
        },
        "pluginId": {
          "maxLength": 128,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$",
          "type": "string"
        },
        "pluginVersion": {
          "$ref": "#/$defs/PluginVersion"
        },
        "protocolVersion": {
          "const": 1
        },
        "proxyRequestId": {
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/HostHttpRequestProposal"
        },
        "requestId": {
          "pattern": "^[A-Za-z0-9_.-]{1,128}$",
          "type": "string"
        }
      },
      "required": [
        "protocolVersion",
        "pluginId",
        "pluginVersion",
        "artifactSha256",
        "deploymentGeneration",
        "requestId",
        "capabilityId",
        "capabilityVersion",
        "proxyRequestId",
        "request"
      ],
