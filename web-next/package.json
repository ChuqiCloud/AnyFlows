{
  "name": "@anyflows/web-next",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "api:generate": "cargo xtask openapi export && openapi-ts --no-log-file && node scripts/normalize-generated-api.mjs",
    "api:check": "node scripts/check-generated-api.mjs",
    "build": "tsc -b && vite build",
    "check": "pnpm lint && pnpm build",
    "lint": "node --test scripts/*.test.mjs && node scripts/check-generated-api.mjs && oxlint",
    "preview": "vite preview",
    "test:scripts": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.38",
    "@ai-sdk/openai": "4.0.27",
    "@ai-sdk/openai-compatible": "3.0.16",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@heroui/react": "2.8.10",
    "@heroui/switch": "2.2.27",
    "@heroui/system": "2.4.28",
    "@heroui/theme": "2.4.26",
    "@heroui/use-theme": "2.1.10",
    "@hookform/resolvers": "^5.5.7",
    "@iconify/react": "^6.0.2",
    "@lobehub/icons": "^5.19.3",
    "@react-aria/visually-hidden": "3.9.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@rc-component/qrcode": "2.0.0",
    "@stripe/react-stripe-js": "6.8.0",
    "@stripe/stripe-js": "9.13.0",
    "@tanstack/react-query": "^5.101.4",
    "ai": "7.0.41",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "framer-motion": "12.38.0",
    "i18next": "^26.3.6",
    "katex": "0.18.1",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.83.0",
    "react-i18next": "^17.0.11",
    "react-markdown": "10.1.0",
