{
  "openapi": "3.1.0",
  "info": {
    "title": "AnyFlows 管理 API",
    "version": "0.1.0",
    "description": "AnyFlows 管理会话 API 契约。"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "operationId": "loginManagementSession",
        "summary": "登录并签发管理会话",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidCredentials"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "operationId": "getManagementSession",
        "summary": "读取当前管理会话",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "会话有效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/admin/users": {
      "get": {
        "operationId": "listAdminUsers",
        "summary": "读取管理员用户列表",
        "description": "按稳定用户 ID 游标读取未软删除用户的非敏感管理快照。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "上一页最后一个用户 ID，缺省时从最小 ID 开始。"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": "单页返回数量，默认 50，最大 100。"
          }
        ],
        "responses": {
          "200": {
            "description": "用户列表读取成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "post": {
        "operationId": "createAdminUser",
        "summary": "创建管理员用户",
        "description": "创建用户并返回不含密码、密码哈希和内部设置的管理快照。密码缺省时不设置密码登录材料。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminUserWriteRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "用户创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUser"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/UserConflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/admin/users/{id}": {
      "get": {
        "operationId": "getAdminUser",
        "summary": "读取管理员用户详情",
        "description": "读取单个未软删除用户的非敏感管理快照。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "用户 ID。"
          }
        ],
        "responses": {
          "200": {
            "description": "用户详情读取成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUser"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/UserNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "put": {
        "operationId": "updateAdminUser",
        "summary": "更新管理员用户",
        "description": "完整更新未软删除用户的可写账户字段；密码缺省或为 null 时保持原密码。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "用户 ID。"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminUserWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "用户更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUser"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/UserNotFound"
          },
          "409": {
            "$ref": "#/components/responses/UserConflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "delete": {
        "operationId": "deleteAdminUser",
        "summary": "软删除管理员用户",
        "description": "软删除用户，并在同一事务内软删除该用户尚未删除的令牌。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "用户 ID。"
          }
        ],
        "responses": {
          "204": {
            "description": "用户软删除成功"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/UserNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/admin/groups": {
      "get": {
        "operationId": "listAdminGroups",
        "summary": "读取管理员分组列表",
        "description": "按稳定分组 ID 游标读取未软删除分组的完整管理快照。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "上一页最后一个分组 ID，缺省时从最小 ID 开始。"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": "单页返回数量，默认 50，最大 100。"
          }
        ],
        "responses": {
          "200": {
            "description": "分组列表读取成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminGroupListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "post": {
        "operationId": "createAdminGroup",
        "summary": "创建管理员分组",
        "description": "创建分组并返回完整管理快照；倍率和限额均使用整数，三个高峰字段必须同时为空或同时有值。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminGroupWriteRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "分组创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminGroup"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/GroupConflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/admin/groups/{id}": {
      "get": {
        "operationId": "getAdminGroup",
        "summary": "读取管理员分组详情",
        "description": "读取单个未软删除分组的完整管理快照。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "分组 ID。"
          }
        ],
        "responses": {
          "200": {
            "description": "分组详情读取成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminGroup"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/GroupNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "put": {
        "operationId": "updateAdminGroup",
        "summary": "更新管理员分组",
        "description": "完整更新未软删除分组的可写业务字段；回退分组必须存在且不能指向自身。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "分组 ID。"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminGroupWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "分组更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminGroup"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/GroupNotFound"
          },
          "409": {
            "$ref": "#/components/responses/GroupConflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "delete": {
        "operationId": "deleteAdminGroup",
        "summary": "安全软删除管理员分组",
        "description": "软删除分组并清理可安全解除的运行时关系；仍被有效用户或有效令牌引用时拒绝删除。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "分组 ID。"
          }
        ],
        "responses": {
          "204": {
            "description": "分组软删除成功"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/GroupNotFound"
          },
          "409": {
            "$ref": "#/components/responses/GroupInUse"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/admin/tokens": {
      "get": {
        "operationId": "listAdminTokens",
        "summary": "读取管理员令牌列表",
        "description": "按稳定令牌 ID 游标读取未软删除令牌的非敏感管理快照。响应只包含不可用于鉴权的展示前缀。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "上一页最后一个令牌 ID，缺省时从最小 ID 开始。"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": "单页返回数量，默认 50，最大 100。"
          }
        ],
        "responses": {
          "200": {
            "description": "令牌列表读取成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminTokenListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "post": {
        "operationId": "createAdminToken",
        "summary": "签发管理员令牌",
        "description": "签发新的下游 API Key。完整密钥只在本次响应中返回一次，数据库仅保存 SHA-256 摘要与展示前缀。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminTokenWriteRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "令牌签发成功，完整密钥仅在此响应出现",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedAdminToken"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/admin/tokens/{id}": {
      "get": {
        "operationId": "getAdminToken",
        "summary": "读取管理员令牌详情",
        "description": "读取单个未软删除令牌的非敏感管理快照，不返回完整密钥或密钥摘要。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "?? ID?"
          }
        ],
        "responses": {
          "200": {
            "description": "令牌详情读取成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminToken"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/TokenNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "put": {
        "operationId": "updateAdminToken",
        "summary": "完整更新管理员令牌",
        "description": "完整更新未软删除令牌的配置。user_id 仅用于确认现有归属，不允许转移令牌；密钥、累计用量和窗口起点保持不变。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "令牌 ID。"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminTokenWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "令牌更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminToken"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/TokenNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "delete": {
        "operationId": "deleteAdminToken",
        "summary": "软删除管理员令牌",
        "description": "软删除令牌并阻止后续鉴权，历史计费和用量审计关联保持不变。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "令牌 ID。"
          }
        ],
        "responses": {
          "204": {
            "description": "令牌删除成功"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/TokenNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "InvalidRequest": {
        "description": "请求正文无效",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ManagementError"
            }
          }
        }
      },
      "InvalidCredentials": {
        "description": "登录凭据无效",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ManagementError"
            }
          }
        }
      },
      "InvalidSession": {
        "description": "管理会话无效",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ManagementError"
            }
          }
        }
      },
      "Forbidden": {
        "description": "当前会话没有管理员权限",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ManagementError"
            }
          }
        }
      },
      "UserNotFound": {
        "description": "用户不存在或已经被软删除",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ManagementError"
            }
          }
        }
      },
      "GroupNotFound": {
        "description": "分组不存在或已经被软删除",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ManagementError"
            }
          }
        }
      },
      "UserConflict": {
        "description": "用户名或邮箱与当前有效用户冲突",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ManagementError"
            }
          }
        }
      },
      "GroupConflict": {
        "description": "分组名与当前有效分组冲突",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ManagementError"
            }
          }
        }
      },
      "GroupInUse": {
        "description": "分组仍被有效用户或有效令牌引用",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ManagementError"
            }
          }
        }
      },
      "InternalError": {
        "description": "服务内部错误",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ManagementError"
            }
          }
        }
      },
      "TokenNotFound": {
        "description": "令牌不存在或已经被软删除",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ManagementError"
            }
          }
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "password": {
            "type": "string",
            "maxLength": 4096,
            "format": "password"
          }
        }
      },
      "SessionUser": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ]
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "expires_at",
          "user"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expires_in": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 86400
          },
          "expires_at": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user",
          "expires_at"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          },
          "expires_at": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        }
      },
      "AdminUserStatus": {
        "type": "string",
        "enum": [
          "enabled",
          "disabled"
        ]
      },
      "AdminUser": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "username",
          "email",
          "role",
          "status",
          "default_group_id",
          "quota",
          "used_quota",
          "frozen_quota",
          "request_count",
          "rpm_limit",
          "concurrency"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "format": "email",
            "maxLength": 320
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/AdminUserStatus"
          },
          "default_group_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "quota": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "used_quota": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "frozen_quota": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "request_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "rpm_limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "concurrency": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "AdminUserWriteRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "role",
          "status",
          "default_group_id",
          "quota"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 320
          },
          "password": {
            "type": [
              "string",
              "null"
            ],
            "format": "password",
            "minLength": 1,
            "maxLength": 4096
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/AdminUserStatus"
          },
          "default_group_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "quota": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "rpm_limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "concurrency": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "AdminUserListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "users",
          "next_cursor"
        ],
        "properties": {
          "users": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/AdminUser"
            }
          },
          "next_cursor": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 1
          }
        }
      },
      "AdminGroup": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "display_name",
          "ratio_micros",
          "peak_ratio_micros",
          "peak_start",
          "peak_end",
          "is_exclusive",
          "daily_limit",
          "weekly_limit",
          "monthly_limit",
          "rpm_limit",
          "fallback_group_id",
          "flags"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "ratio_micros": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "百万分比定点倍率，1000000 表示 1.0。"
          },
          "peak_ratio_micros": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "peak_start": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
          },
          "peak_end": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
          },
          "is_exclusive": {
            "type": "boolean"
          },
          "daily_limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "weekly_limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "monthly_limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "rpm_limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "fallback_group_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 1
          },
          "flags": {
            "type": "object",
            "additionalProperties": true,
            "description": "受限 JSON 对象，服务端编码后最大 16 KiB。"
          }
        }
      },
      "AdminGroupWriteRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "display_name",
          "ratio_micros",
          "is_exclusive",
          "flags"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "ratio_micros": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "百万分比定点倍率，1000000 表示 1.0。"
          },
          "peak_ratio_micros": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0,
            "description": "与 peak_start、peak_end 同时为空或同时有值。"
          },
          "peak_start": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
          },
          "peak_end": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
          },
          "is_exclusive": {
            "type": "boolean"
          },
          "daily_limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "weekly_limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "monthly_limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "rpm_limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "fallback_group_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 1
          },
          "flags": {
            "type": "object",
            "additionalProperties": true,
            "description": "受限 JSON 对象，服务端编码后最大 16 KiB。"
          }
        }
      },
      "AdminGroupListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "groups",
          "next_cursor"
        ],
        "properties": {
          "groups": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/AdminGroup"
            }
          },
          "next_cursor": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 1
          }
        }
      },
      "ManagementError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "invalid_credentials",
              "invalid_session",
              "forbidden",
              "user_not_found",
              "group_not_found",
              "token_not_found",
              "user_conflict",
              "group_conflict",
              "group_in_use",
              "internal_error"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "AdminTokenStatus": {
        "type": "string",
        "enum": [
          "enabled",
          "disabled"
        ]
      },
      "AdminTokenWriteRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user_id",
          "name",
          "status",
          "group_id",
          "remain_quota",
          "unlimited_quota",
          "expired_at",
          "model_limits",
          "allow_ips",
          "cross_group_retry",
          "rate_limit_5h",
          "rate_limit_1d",
          "rate_limit_7d",
          "max_requests"
        ],
        "properties": {
          "user_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "令牌所属用户 ID；更新时必须与现有归属一致。"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "$ref": "#/components/schemas/AdminTokenStatus"
          },
          "group_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 1,
            "description": "强制绑定分组；null 表示使用所属用户的默认分组。"
          },
          "remain_quota": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "unlimited_quota": {
            "type": "boolean"
          },
          "expired_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0,
            "description": "Unix 秒时间戳；null 表示永不过期。"
          },
          "model_limits": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 1,
            "maxItems": 512,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "description": "Canonical 模型名白名单；null 表示不限制，顺序和重复项会保留。"
          },
          "allow_ips": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "description": "IP/CIDR 白名单；null 表示关闭过滤，顺序和重复项会保留。"
          },
          "cross_group_retry": {
            "type": "boolean"
          },
          "rate_limit_5h": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "rate_limit_1d": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "rate_limit_7d": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "max_requests": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "IssuedAdminToken": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api_key",
          "token"
        ],
        "properties": {
          "api_key": {
            "type": "string",
            "minLength": 49,
            "maxLength": 49,
            "pattern": "^sk-af-[A-Za-z0-9_-]{43}$",
            "description": "只在本次签发响应中出现的完整 API Key。"
          },
          "token": {
            "$ref": "#/components/schemas/AdminToken"
          }
        }
      },
      "AdminToken": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "user_id",
          "key_prefix",
          "name",
          "status",
          "group_id",
          "remain_quota",
          "unlimited_quota",
          "used_quota",
          "expired_at",
          "model_limits",
          "allow_ips",
          "cross_group_retry",
          "rate_limit_5h",
          "rate_limit_1d",
          "rate_limit_7d",
          "usage_5h",
          "usage_1d",
          "usage_7d",
          "window_5h_start",
          "window_1d_start",
          "window_7d_start",
          "max_requests",
          "used_requests"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "user_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "key_prefix": {
            "type": "string",
            "minLength": 18,
            "maxLength": 18,
            "pattern": "^sk-af-[A-Za-z0-9_-]{12}$",
            "description": "不可用于鉴权的 18 字符展示前缀。"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "$ref": "#/components/schemas/AdminTokenStatus"
          },
          "group_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 1
          },
          "remain_quota": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "unlimited_quota": {
            "type": "boolean"
          },
          "used_quota": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "expired_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0,
            "description": "Unix 秒时间戳；null 表示永不过期。"
          },
          "model_limits": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 1,
            "maxItems": 512,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "description": "Canonical 模型名白名单；null 表示不限制，保留持久化顺序和重复项。"
          },
          "allow_ips": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "description": "IP/CIDR 白名单；null 表示关闭过滤，保留持久化顺序和重复项。"
          },
          "cross_group_retry": {
            "type": "boolean"
          },
          "rate_limit_5h": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "rate_limit_1d": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "rate_limit_7d": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "usage_5h": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "usage_1d": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "usage_7d": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "window_5h_start": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "window_1d_start": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "window_7d_start": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "max_requests": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "used_requests": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "AdminTokenListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tokens",
          "next_cursor"
        ],
        "properties": {
          "tokens": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/AdminToken"
            }
          },
          "next_cursor": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 1
          }
        }
      }
    }
  }
}
