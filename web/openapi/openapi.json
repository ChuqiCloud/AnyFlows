{
  "openapi": "3.1.0",
  "info": {
    "title": "AnyFlows 管理 API",
    "version": "0.1.0",
    "description": "AnyFlows 管理会话 API 契约。"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "operationId": "loginManagementSession",
        "summary": "登录并签发管理会话",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidCredentials"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "operationId": "getManagementSession",
        "summary": "读取当前管理会话",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "会话有效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/admin/users": {
      "get": {
        "operationId": "listAdminUsers",
        "summary": "读取管理员用户列表",
        "description": "按稳定用户 ID 游标读取未软删除用户的非敏感管理快照。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "上一页最后一个用户 ID，缺省时从最小 ID 开始。"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": "单页返回数量，默认 50，最大 100。"
          }
        ],
        "responses": {
          "200": {
            "description": "用户列表读取成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "post": {
        "operationId": "createAdminUser",
        "summary": "创建管理员用户",
        "description": "创建用户并返回不含密码、密码哈希和内部设置的管理快照。密码缺省时不设置密码登录材料。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminUserWriteRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "用户创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUser"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/UserConflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/admin/users/{id}": {
      "get": {
        "operationId": "getAdminUser",
        "summary": "读取管理员用户详情",
        "description": "读取单个未软删除用户的非敏感管理快照。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "用户 ID。"
          }
        ],
        "responses": {
          "200": {
            "description": "用户详情读取成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUser"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/UserNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "put": {
        "operationId": "updateAdminUser",
        "summary": "更新管理员用户",
        "description": "完整更新未软删除用户的可写账户字段；密码缺省或为 null 时保持原密码。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "用户 ID。"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminUserWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "用户更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUser"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/UserNotFound"
          },
          "409": {
            "$ref": "#/components/responses/UserConflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "delete": {
        "operationId": "deleteAdminUser",
        "summary": "软删除管理员用户",
        "description": "软删除用户，并在同一事务内软删除该用户尚未删除的令牌。",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "用户 ID。"
          }
        ],
        "responses": {
          "204": {
            "description": "用户软删除成功"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidSession"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/UserNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "InvalidRequest": {
        "description": "请求正文无效",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ManagementError"
            }
          }
        }
      },
      "InvalidCredentials": {
        "description": "登录凭据无效",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ManagementError"
            }
          }
        }
      },
      "InvalidSession": {
        "description": "管理会话无效",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ManagementError"
            }
          }
        }
      },
      "Forbidden": {
        "description": "当前会话没有管理员权限",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ManagementError"
            }
          }
        }
      },
      "UserNotFound": {
        "description": "用户不存在或已经被软删除",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ManagementError"
            }
          }
        }
      },
      "UserConflict": {
        "description": "用户名或邮箱与当前有效用户冲突",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ManagementError"
            }
          }
        }
      },
      "InternalError": {
        "description": "服务内部错误",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ManagementError"
            }
          }
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "password": {
            "type": "string",
            "maxLength": 4096,
            "format": "password"
          }
        }
      },
      "SessionUser": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ]
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "expires_at",
          "user"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expires_in": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 86400
          },
          "expires_at": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user",
          "expires_at"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          },
          "expires_at": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          }
        }
      },
      "AdminUserStatus": {
        "type": "string",
        "enum": [
          "enabled",
          "disabled"
        ]
      },
      "AdminUser": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "username",
          "email",
          "role",
          "status",
          "default_group_id",
          "quota",
          "used_quota",
          "frozen_quota",
          "request_count",
          "rpm_limit",
          "concurrency"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "format": "email",
            "maxLength": 320
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/AdminUserStatus"
          },
          "default_group_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "quota": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "used_quota": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "frozen_quota": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "request_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "rpm_limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "concurrency": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "AdminUserWriteRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "role",
          "status",
          "default_group_id",
          "quota"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 320
          },
          "password": {
            "type": [
              "string",
              "null"
            ],
            "format": "password",
            "minLength": 1,
            "maxLength": 4096
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/AdminUserStatus"
          },
          "default_group_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "quota": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "rpm_limit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "concurrency": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "AdminUserListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "users",
          "next_cursor"
        ],
        "properties": {
          "users": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/AdminUser"
            }
          },
          "next_cursor": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 1
          }
        }
      },
      "ManagementError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "invalid_credentials",
              "invalid_session",
              "forbidden",
              "user_not_found",
              "user_conflict",
              "internal_error"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
