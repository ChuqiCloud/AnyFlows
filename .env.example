# AnyFlows 手工启动时会自动读取当前工作目录的 .env；同名进程环境变量优先。
# 可选：显式指定 TOML 文件。未设置时优先读取 anyflows.conf，再兼容 anyflows.toml。
# AF_CONFIG_FILE=anyflows.conf

# 服务仍只允许监听 loopback；基础鉴权不代表已完成公网安全闭环。
AF_SERVER__BIND=127.0.0.1:8080
# 收到关闭信号后等待在途请求完成的秒数，范围 1..=300，默认 30。
# AF_SERVER__SHUTDOWN_TIMEOUT_SECS=30
# 浏览器跨域默认关闭；仅填写完整 HTTP(S) Origin，不得使用通配符或路径。
# AF_SERVER__CORS_ALLOWED_ORIGINS=["http://127.0.0.1:5173"]
# 默认只信任 TCP 对端，并移除且忽略 XFF、Forwarded 等客户端地址头。
# AF_SERVER__CLIENT_IP_SOURCE=peer
# 启用 XFF 时必须同时配置非 /0 的静态代理网段；loopback 表示信任同机所有可连接进程。
# AF_SERVER__CLIENT_IP_SOURCE=x-forwarded-for
# AF_SERVER__TRUSTED_PROXY_CIDRS=["127.0.0.1/32"]

# 仅控制 AnyFlows 自身结构化日志；生产默认 info，排障时可改为 debug/trace。
AF_TELEMETRY__LEVEL=info

# 数据库 URL 为必填项；示例使用可自动创建的本地 SQLite 文件。
AF_DATABASE__URL=sqlite://anyflows.db?mode=rwc
# 可选覆盖；未设置时沿用 af-db 的 600 秒默认值。
# AF_DATABASE__MIGRATION_TIMEOUT_SECS=600
# 就绪探针复用此数据库健康检查截止时间，范围 1..=30 秒，默认 5 秒。
# AF_DATABASE__HEALTH_CHECK_TIMEOUT_SECS=5

# 批量模式默认关闭；关闭时每个事件写入 WAL 后立即落库，仍保留崩溃恢复语义。
# AF_BILLING__BATCH_ENABLED=false
# 批量模式的落库周期，范围 1..=3600 秒，默认 5。
# AF_BILLING__FLUSH_INTERVAL_SECS=5
# 启动恢复和关闭最终 flush 的硬截止，范围 1..=300 秒，默认 30。
# AF_BILLING__FLUSH_TIMEOUT_SECS=30
# 已接收但尚未获得日志数据库确认的用量事实容量，范围 1..=1000000，默认 4096；满时请求会失败关闭。
# AF_BILLING__USAGE_RECORD_QUEUE_CAPACITY=4096
# 用量日志持久化 worker 数，范围 1..=64，默认 1；多个 worker 共享相同 event_id 幂等边界。
# AF_BILLING__USAGE_RECORD_WORKER_COUNT=1
# 每个服务实例必须独占一个目录；路径不会进入日志或配置错误。
# AF_BILLING__WAL_DIRECTORY=data/billing-wal

# 订阅生命周期任务默认开启；关闭后 Active 窗口和 Canceled 过期状态不会自动推进。
# AF_SUBSCRIPTION__ENABLED=true
# 单批读取数量，范围 1..=100，默认 64。
# AF_SUBSCRIPTION__BATCH_SIZE=64
# 两轮扫描间隔，范围 1..=3600 秒，默认 60。
# AF_SUBSCRIPTION__INTERVAL_SECS=60
# Active 与 Canceled 两类状态各自单轮最多扫描的批次数，范围 1..=64，默认 8。
# AF_SUBSCRIPTION__MAX_BATCHES_PER_RUN=8

# 支付 Provider 默认关闭；服务端密钥、publishable key 与 webhook 密钥齐全后才允许创建 PaymentIntent。
# API 密钥只能通过部署密钥管理注入，不得写入仓库、日志或镜像层。
# AF_PAYMENT__STRIPE_SECRET_KEY=sk_live_replace-with-deployment-secret
# publishable key 只会通过已登录钱包配置接口公开，且必须与服务端密钥属于同一 Stripe 环境。
# AF_PAYMENT__STRIPE_PUBLISHABLE_KEY=pk_live_replace-with-publishable-key
# webhook 密钥可单独配置以继续接收历史回调。
# AF_PAYMENT__STRIPE_WEBHOOK_SECRET=whsec_replace-with-deployment-secret
# Stripe 签名时间容差范围 1..=86400 秒，默认 300。
# AF_PAYMENT__STRIPE_SIGNATURE_TOLERANCE_SECS=300

# 支付宝实名认证默认关闭；启用后必须同时配置应用 ID、应用私钥和支付宝公钥。
# 密钥只能通过部署密钥管理注入，不得写入仓库、日志或镜像层。
# AF_ACCOUNT_VERIFICATION__ALIPAY__ENABLED=false
# AF_ACCOUNT_VERIFICATION__ALIPAY__APP_ID=replace-with-alipay-app-id
# AF_ACCOUNT_VERIFICATION__ALIPAY__PRIVATE_KEY=replace-with-pkcs8-or-pkcs1-private-key
# AF_ACCOUNT_VERIFICATION__ALIPAY__PUBLIC_KEY=replace-with-alipay-public-key
# AF_ACCOUNT_VERIFICATION__ALIPAY__GATEWAY_URL=https://openapi.alipay.com/gateway.do
# AF_ACCOUNT_VERIFICATION__ALIPAY__BIZ_CODE=FACE
# AF_ACCOUNT_VERIFICATION__ALIPAY__TIMEOUT_SECS=8

# 生产数据库渠道转发必须配置：固定标识 + 32 字节密钥的 Base64URL 无填充文本；探活复用同一密钥。
# 密钥只能通过部署密钥管理注入，不得写入仓库、日志或镜像层。
# AF_CREDENTIAL_ENCRYPTION__KEY_ID=primary
# AF_CREDENTIAL_ENCRYPTION__KEY=replace-with-32-byte-base64url-key

# 自动禁用渠道探活默认关闭；启用后会使用数据库渠道、模型和加密凭据做真实测试调用。
# AF_CHANNEL_PROBE__ENABLED=false
# 单轮最多读取的渠道数量，范围 1..=64，默认 16。
# AF_CHANNEL_PROBE__BATCH_SIZE=16
# 两轮探活之间的等待时间，范围 1..=3600 秒，默认 60。
# AF_CHANNEL_PROBE__INTERVAL_SECS=60
# 单渠道探活硬超时，范围 1..=300 秒，默认 10。
# AF_CHANNEL_PROBE__PROBE_TIMEOUT_SECS=10

# Redis 未配置时 OAuth 刷新租约保持单实例本地模式；配置后启动与命令故障不会降级为无锁执行。
# AF_REDIS__URL=redis://127.0.0.1:6379/
# 请求限流键空间用于多实例共享固定窗口；默认值为 anyflows.gateway.rpm.v1，变更会使旧窗口失效。
# AF_REDIS__REQUEST_RATE_LIMIT_NAMESPACE=anyflows.gateway.rpm.v1

# 可选的 ClickHouse 只读分析源；完整配置段缺失时继续从事务主库读取看板事实。
# 端点只允许无凭据、无查询参数的 HTTP(S) 地址；查询必须返回单行 JSONEachRow 快照，且包含两个时间占位符。
# AF_CLICKHOUSE_ANALYTICS__ENDPOINT=https://clickhouse.example:8443
# 请替换为返回 AnyFlows 看板快照结构的单条查询；禁止分号，并保留这两个 ClickHouse 参数占位符。
# AF_CLICKHOUSE_ANALYTICS__QUERY="SELECT * FROM anyflows_dashboard_snapshots WHERE period_start >= {period_start:Int64} AND period_end <= {period_end:Int64} LIMIT 1"
# 只读账号，仅用于分析读取；密码只能从部署密钥管理注入。
# AF_CLICKHOUSE_ANALYTICS__USERNAME=dashboard-reader
# AF_CLICKHOUSE_ANALYTICS__PASSWORD=replace-with-clickhouse-readonly-password
# 查询超时范围 1..=300 秒，默认 5；单行响应上限范围 1..=4194304 字节，默认 1048576。
# AF_CLICKHOUSE_ANALYTICS__TIMEOUT_SECS=5
# AF_CLICKHOUSE_ANALYTICS__MAX_RESPONSE_BYTES=1048576

# 可选的 ClickHouse 异步事实投递；与只读分析账号分离，完整配置段缺失时不启动投递 worker。
# 端点仍只允许无凭据、无查询参数的 HTTP(S) 地址；查询必须是单条 INSERT INTO，运行时追加 JSONEachRow 与异步写入参数。
# AF_CLICKHOUSE_EXPORT__ENDPOINT=https://clickhouse.example:8443
# 表名和列映射需按部署侧 ClickHouse schema 替换，不能包含分号或控制字符。
# AF_CLICKHOUSE_EXPORT__USAGE_INSERT_QUERY="INSERT INTO anyflows_usage_facts"
# AF_CLICKHOUSE_EXPORT__OUTCOME_INSERT_QUERY="INSERT INTO anyflows_request_outcome_facts"
# 独立写入账号，不得复用只读分析账号；密码只能从部署密钥管理注入。
# AF_CLICKHOUSE_EXPORT__USERNAME=analytics-writer
# AF_CLICKHOUSE_EXPORT__PASSWORD=replace-with-clickhouse-writer-password
# 单轮批量范围 1..=256，默认 64；扫描周期范围 1..=3600 秒，默认 5。
# AF_CLICKHOUSE_EXPORT__BATCH_SIZE=64
# AF_CLICKHOUSE_EXPORT__INTERVAL_SECS=5
# 请求超时范围 1..=300 秒，默认 5；请求体上限范围 1..=16777216 字节，默认 4194304。
# AF_CLICKHOUSE_EXPORT__TIMEOUT_SECS=5
# AF_CLICKHOUSE_EXPORT__MAX_REQUEST_BYTES=4194304
# 历史事实回填单轮范围 1..=256，默认 128；主库事实始终保留，投递失败会在 outbox 中重试。
# AF_CLICKHOUSE_EXPORT__BACKFILL_BATCH_SIZE=128

# 查询参数传递 API Key 默认关闭，避免凭据进入 URL、访问日志和浏览器历史。
# AF_AUTH__ALLOW_QUERY_API_KEY=false
# 认证仓储查询硬超时，范围 1..=30 秒，默认 2 秒。
# AF_AUTH__LOOKUP_TIMEOUT_SECS=2
# 管理 API JWT 签名密钥必须是 32 字节随机值的 Base64URL 无填充文本；未配置时服务拒绝启动。
# AF_AUTH__SESSION_SIGNING_KEY=replace-with-32-byte-base64url-key
# 管理 API JWT 有效期，范围 1..=86400 秒，默认 3600。
# AF_AUTH__SESSION_TTL_SECS=3600

# Cloudflare Turnstile 默认关闭；必须同时设置 site key 与服务端 secret 才会启用。
# Secret 只从启动配置读取，不会进入数据库、日志或公开站点投影。
# AF_TURNSTILE__SITE_KEY=replace-with-turnstile-site-key
# AF_TURNSTILE__SECRET_KEY=replace-with-turnstile-secret-key
# AF_TURNSTILE__TIMEOUT_SECS=5

# 上游订阅账号 OAuth 只从启动配置读取客户端材料；未配置的 provider 不注册且不占用回调端口。
# 待授权会话容量范围 1..=4096，默认 256；有效期范围 60..=900 秒，默认 600。
# AF_OAUTH__MAX_PENDING_AUTHORIZATIONS=256
# AF_OAUTH__SESSION_TTL_SECS=600
# token 周期刷新默认开启；关闭后不会扫描、回填或连接 Redis 租约。
# AF_OAUTH__REFRESH_ENABLED=true
# 启动后立即扫描，后续周期范围 1..=3600 秒，默认 60。
# AF_OAUTH__REFRESH_INTERVAL_SECS=60
# access token 到期前进入刷新候选集的秒数，范围 1..=86400，默认 300。
# AF_OAUTH__REFRESH_BEFORE_EXPIRY_SECS=300
# 单轮候选数范围 1..=256，默认 64。
# AF_OAUTH__REFRESH_BATCH_SIZE=64
# 单实例并发数范围 1..=64 且不得超过批次，默认 8。
# AF_OAUTH__REFRESH_CONCURRENCY=8
# Claude Code 与 Codex 使用公共客户端，不接受 client secret。
# Claude Code 固定使用 54545 端口的 localhost 回调，并以 JSON 交换 token。
# AF_OAUTH__CLAUDE_CODE__CLIENT_ID=replace-with-claude-code-client-id
# Codex 使用内置客户端，不需要设置 AF_OAUTH__CODEX__CLIENT_ID。
# Gemini CLI 与 Antigravity 必须同时配置 client ID 和 client secret。
# AF_OAUTH__GEMINI__CLIENT_ID=replace-with-gemini-client-id
# AF_OAUTH__GEMINI__CLIENT_SECRET=replace-with-gemini-client-secret
# AF_OAUTH__ANTIGRAVITY__CLIENT_ID=replace-with-antigravity-client-id
# AF_OAUTH__ANTIGRAVITY__CLIENT_SECRET=replace-with-antigravity-client-secret

# M1 生产 Chat 只读取数据库渠道、能力与加密凭据，不再使用静态单上游配置，也不会回退静态目标。
# 兼容旧版嵌入式场景的可选静态 OpenAI-compatible 上游；M1 生产转发不会读取这些值作为回退目标。
# 三项必须同时配置，URL 不得包含凭据、查询参数或片段；API Key 只能从部署密钥管理注入。
# AF_OPENAI_UPSTREAM__BASE_URL=https://upstream.example
# AF_OPENAI_UPSTREAM__MODEL=replace-with-model-name
# AF_OPENAI_UPSTREAM__API_KEY=replace-with-deployment-secret

# 可选覆盖；未设置时沿用 af-httpclient 的 128、5/300/900 秒默认值。
# AF_HTTP_CLIENT__MAX_CACHED_CLIENTS=128
# AF_HTTP_CLIENT__CONNECT_TIMEOUT_SECS=5
# AF_HTTP_CLIENT__READ_TIMEOUT_SECS=300
# AF_HTTP_CLIENT__REQUEST_TIMEOUT_SECS=900
# 本机访问海外上游时显式使用 SOCKS5 代理；运行时不会读取系统代理环境变量。
# AF_HTTP_CLIENT__PROXY_URL=socks5://127.0.0.1:10808
# 仅 HTTP(S)/SOCKS5H 等代理端解析 DNS 时设为 true，并确保代理执行等价 SSRF 防护。
# AF_HTTP_CLIENT__TRUST_PROXY_DNS=false
