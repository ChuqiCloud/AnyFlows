# 可选：显式指定 TOML 文件。未设置时仅在当前目录读取可选的 anyflows.toml。
# AF_CONFIG_FILE=anyflows.toml

# 服务仍只允许监听 loopback；基础鉴权不代表已完成公网安全闭环。
AF_SERVER__BIND=127.0.0.1:8080
# 收到关闭信号后等待在途请求完成的秒数，范围 1..=300，默认 30。
# AF_SERVER__SHUTDOWN_TIMEOUT_SECS=30
# 浏览器跨域默认关闭；仅填写完整 HTTP(S) Origin，不得使用通配符或路径。
# AF_SERVER__CORS_ALLOWED_ORIGINS=["http://127.0.0.1:5173"]
# 默认只信任 TCP 对端，并移除且忽略 XFF、Forwarded 等客户端地址头。
# AF_SERVER__CLIENT_IP_SOURCE=peer
# 启用 XFF 时必须同时配置非 /0 的静态代理网段；loopback 表示信任同机所有可连接进程。
# AF_SERVER__CLIENT_IP_SOURCE=x-forwarded-for
# AF_SERVER__TRUSTED_PROXY_CIDRS=["127.0.0.1/32"]

# 仅控制 AnyFlows 自身结构化日志；生产默认 info，排障时可改为 debug/trace。
AF_TELEMETRY__LEVEL=info

# 数据库 URL 为必填项；示例使用可自动创建的本地 SQLite 文件。
AF_DATABASE__URL=sqlite://anyflows.db?mode=rwc
# 可选覆盖；未设置时沿用 af-db 的 600 秒默认值。
# AF_DATABASE__MIGRATION_TIMEOUT_SECS=600
# 就绪探针复用此数据库健康检查截止时间，范围 1..=30 秒，默认 5 秒。
# AF_DATABASE__HEALTH_CHECK_TIMEOUT_SECS=5

# Redis 未配置时缓存层保持单实例本地模式。
# AF_REDIS__URL=redis://127.0.0.1:6379/

# 查询参数传递 API Key 默认关闭，避免凭据进入 URL、访问日志和浏览器历史。
# AF_AUTH__ALLOW_QUERY_API_KEY=false
# 认证仓储查询硬超时，范围 1..=30 秒，默认 2 秒。
# AF_AUTH__LOOKUP_TIMEOUT_SECS=2

# 当前使用唯一 OpenAI-compatible 上游；三项均为必填启动配置。
AF_OPENAI_UPSTREAM__BASE_URL=https://api.openai.com
AF_OPENAI_UPSTREAM__MODEL=gpt-4o-mini
AF_OPENAI_UPSTREAM__API_KEY=replace-with-upstream-api-key

# 可选覆盖；未设置时沿用 af-httpclient 的 128、5/300/900 秒默认值。
# AF_HTTP_CLIENT__MAX_CACHED_CLIENTS=128
# AF_HTTP_CLIENT__CONNECT_TIMEOUT_SECS=5
# AF_HTTP_CLIENT__READ_TIMEOUT_SECS=300
# AF_HTTP_CLIENT__REQUEST_TIMEOUT_SECS=900
# 本机访问海外上游时显式使用 SOCKS5 代理；运行时不会读取系统代理环境变量。
# AF_HTTP_CLIENT__PROXY_URL=socks5://127.0.0.1:10808
# 仅 HTTP(S)/SOCKS5H 等代理端解析 DNS 时设为 true，并确保代理执行等价 SSRF 防护。
# AF_HTTP_CLIENT__TRUST_PROXY_DNS=false
