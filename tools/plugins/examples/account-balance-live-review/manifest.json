  ],
  "limits": {
    "maxConcurrency": 1,
    "requestTimeoutMs": 5000,
    "maxResponseBytes": 16384,
    "maxPageSize": 1
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false
  },
  "uiViews": [
    {
      "id": "live-balance-review-notice",
      "schemaVersion": 1,
      "slot": "external_account",
      "blocks": [
        {
          "type": "info_card",
          "title": {
            "en": "Live balance comparison",
            "zh": "当前余额对比"
          },
          "description": {
            "en": "A fresh balance read requires your approval for each review.",
