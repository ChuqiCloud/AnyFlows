{
  "pluginId": "org.anyflows.example-channel-monitor-review",
  "displayName": "Example channel monitor event review",
  "pluginVersion": "1.0.0",
  "contractRange": {
    "minimum": {"major": 1, "minor": 0},
    "maximum": {"major": 1, "minor": 0}
  },
  "capabilities": [
    {
      "id": "channel.monitor.events.review.read",
      "version": 1,
      "access": "read",
      "sideEffect": "none",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["events"],
        "properties": {
          "events": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "latency_ms", "occurred_epoch_seconds"],
              "properties": {
                "kind": {"type": "string", "enum": ["down", "recovered"]},
                "latency_ms": {"type": ["integer", "null"], "minimum": 0},
                "occurred_epoch_seconds": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "checks"],
        "properties": {
          "summary": {"type": "string", "minLength": 1, "maxLength": 2048},
          "checks": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "title", "status", "message", "recommendation"],
              "properties": {
                "code": {"type": "string", "minLength": 1, "maxLength": 64},
                "title": {"type": "string", "minLength": 1, "maxLength": 128},
                "status": {"type": "string", "enum": ["pass", "info", "warning", "fail"]},
                "message": {"type": "string", "minLength": 1, "maxLength": 2048},
                "recommendation": {"type": ["string", "null"], "minLength": 1, "maxLength": 2048}
              }
            }
          }
        }
      }
    }
  ],
  "authenticationModes": ["none"],
  "limits": {
    "maxConcurrency": 1,
    "requestTimeoutMs": 5000,
    "maxResponseBytes": 65536,
    "maxPageSize": 1
  },
  "configSchema": {"type": "object", "additionalProperties": false}
}
