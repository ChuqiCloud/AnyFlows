{
  "pluginId": "org.anyflows.example-catalog",
  "displayName": "Example model catalogue",
  "pluginVersion": "1.0.0",
  "contractRange": {
    "minimum": {"major": 1, "minor": 0},
    "maximum": {"major": 1, "minor": 0}
  },
  "capabilities": [
    {
      "id": "catalog.models.read",
      "version": 1,
      "access": "read",
      "sideEffect": "none",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["limit"],
        "properties": {
          "query": {"type": ["string", "null"], "maxLength": 200},
          "cursor": {"type": ["string", "null"], "maxLength": 8},
          "limit": {"type": "integer", "minimum": 1, "maximum": 50}
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["models", "nextCursor"],
        "properties": {
          "models": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "displayName", "provider"],
              "properties": {
                "id": {"type": "string", "minLength": 1, "maxLength": 200},
                "displayName": {"type": "string", "minLength": 1, "maxLength": 200},
                "provider": {"type": "string", "minLength": 1, "maxLength": 100},
                "description": {"type": "string", "maxLength": 2000},
                "contextWindow": {"type": "integer", "minimum": 1},
                "inputModalities": {"type": "array", "items": {"type": "string"}},
                "outputModalities": {"type": "array", "items": {"type": "string"}},
                "tags": {"type": "array", "items": {"type": "string"}}
              }
            }
          },
          "nextCursor": {"type": ["string", "null"], "maxLength": 8}
        }
      }
    },
    {
      "id": "catalog.models.search",
      "version": 1,
      "access": "read",
      "sideEffect": "none",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["limit"],
        "properties": {
          "query": {"type": ["string", "null"], "maxLength": 200},
          "cursor": {"type": ["string", "null"], "maxLength": 8},
          "limit": {"type": "integer", "minimum": 1, "maximum": 50}
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["models", "nextCursor"],
        "properties": {
          "models": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "displayName", "provider"],
              "properties": {
                "id": {"type": "string", "minLength": 1, "maxLength": 200},
                "displayName": {"type": "string", "minLength": 1, "maxLength": 200},
                "provider": {"type": "string", "minLength": 1, "maxLength": 100},
                "description": {"type": "string", "maxLength": 2000},
                "contextWindow": {"type": "integer", "minimum": 1},
                "inputModalities": {"type": "array", "items": {"type": "string"}},
                "outputModalities": {"type": "array", "items": {"type": "string"}},
                "tags": {"type": "array", "items": {"type": "string"}}
              }
            }
          },
          "nextCursor": {"type": ["string", "null"], "maxLength": 8}
        }
      }
    }
  ],
  "authenticationModes": ["none"],
  "limits": {
    "maxConcurrency": 1,
    "requestTimeoutMs": 3000,
    "maxResponseBytes": 262144,
    "maxPageSize": 50
  },
  "configSchema": {"type": "object", "additionalProperties": false}
}
